<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-crafted Tally voucher export covering the cases the parser must
  handle. Six vouchers:
    1. Purchase with inventory + HSN 2710 (Diesel HSD) + CGST/SGST   → high-confidence Scope 1
    2. Purchase of electricity HSN 2716                              → high-confidence Scope 2
    3. Purchase of IT consulting service SAC 9983 + IGST (interstate)→ high-confidence Scope 3
    4. Expense voucher with no inventory block (ledger-only)         → unmapped (no HSN)
    5. Sales invoice                                                 → still ingested (we don't filter type)
    6. Purchase with HSN 99999999                                    → unmapped
  Dates spread across two fiscal years to exercise fiscal_year_for().
-->
<ENVELOPE>
  <BODY>
    <DATA>

      <TALLYMESSAGE>
        <VOUCHER VCHTYPE="Purchase">
          <DATE>20250415</DATE>
          <GUID>tally-vch-0001</GUID>
          <VOUCHERNUMBER>PUR/2025/0001</VOUCHERNUMBER>
          <PARTYLEDGERNAME>Reliance Industries Ltd</PARTYLEDGERNAME>
          <PARTYGSTIN>27AAACR5055K1Z7</PARTYGSTIN>
          <NARRATION>Diesel purchase for DG sets - April top-up</NARRATION>
          <ALLINVENTORYENTRIES.LIST>
            <STOCKITEMNAME>Diesel HSD</STOCKITEMNAME>
            <HSNCODE>27101920</HSNCODE>
            <ACTUALQTY>1000.00 Ltr</ACTUALQTY>
            <AMOUNT>85000.00</AMOUNT>
          </ALLINVENTORYENTRIES.LIST>
          <LEDGERENTRIES.LIST>
            <LEDGERNAME>CGST @ 9%</LEDGERNAME>
            <AMOUNT>7650.00</AMOUNT>
          </LEDGERENTRIES.LIST>
          <LEDGERENTRIES.LIST>
            <LEDGERNAME>SGST @ 9%</LEDGERNAME>
            <AMOUNT>7650.00</AMOUNT>
          </LEDGERENTRIES.LIST>
          <LEDGERENTRIES.LIST>
            <LEDGERNAME>Sundry Creditors</LEDGERNAME>
            <AMOUNT>-100300.00</AMOUNT>
          </LEDGERENTRIES.LIST>
        </VOUCHER>
      </TALLYMESSAGE>

      <TALLYMESSAGE>
        <VOUCHER VCHTYPE="Purchase">
          <DATE>20250420</DATE>
          <GUID>tally-vch-0002</GUID>
          <VOUCHERNUMBER>PUR/2025/0002</VOUCHERNUMBER>
          <PARTYLEDGERNAME>BESCOM</PARTYLEDGERNAME>
          <NARRATION>Electricity bill - April</NARRATION>
          <ALLINVENTORYENTRIES.LIST>
            <STOCKITEMNAME>Electricity Units</STOCKITEMNAME>
            <HSNCODE>27160000</HSNCODE>
            <ACTUALQTY>12500 KWH</ACTUALQTY>
            <AMOUNT>112500.00</AMOUNT>
          </ALLINVENTORYENTRIES.LIST>
        </VOUCHER>
      </TALLYMESSAGE>

      <TALLYMESSAGE>
        <VOUCHER VCHTYPE="Purchase">
          <DATE>20250510</DATE>
          <GUID>tally-vch-0003</GUID>
          <VOUCHERNUMBER>PUR/2025/0003</VOUCHERNUMBER>
