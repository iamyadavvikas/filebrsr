          <PARTYGSTIN>29ABCDE1234F1Z5</PARTYGSTIN>
          <NARRATION>Software development services - Q1</NARRATION>
          <ALLINVENTORYENTRIES.LIST>
            <STOCKITEMNAME>Custom software development</STOCKITEMNAME>
            <HSNCODE>998314</HSNCODE>
            <AMOUNT>500000.00</AMOUNT>
          </ALLINVENTORYENTRIES.LIST>
          <LEDGERENTRIES.LIST>
