{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "functions": {
    "src/app/api/extract/route.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": "https://filebrsr-api.onrender.com/:path*"
    }
  ]
}
